    "mail-test": "node src/mail-test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  }
}
