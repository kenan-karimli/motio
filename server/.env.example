# Copy this file to .env and fill it in. Without SMTP settings the server runs in dev mode:
# codes show in the app (yellow banner) and at http://localhost:8787/dev/outbox instead of being emailed.
PORT=8787
# Production: DATABASE_URL=postgres://... (Neon). Without it, a local Postgres (PGlite) in this folder:
DB_PATH=./data/pg
# MOTIO_DEV=1

# Email through Brevo (free: 300 emails a day). In Brevo: Settings › SMTP & API › SMTP tab.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# "Login" shown on that page (looks like 8a1b2c001@smtp-brevo.com), not your own email
SMTP_USER=
# An SMTP key you generate on that page (not your Brevo password)
SMTP_PASS=
# Must be a sender you verified in Brevo › Senders, domains & dedicated IPs › Senders
MAIL_FROM="Motio <you@example.com>"

# Address the phone uses to reach this server (also Strava's callback). Set this when the server is hosted.
PUBLIC_URL=http://localhost:8787

# Optional: where Help › Send feedback messages are emailed
FEEDBACK_TO=

# Optional: Strava uploads. Create an app at https://www.strava.com/settings/api
# and set its "Authorization Callback Domain" to the host in PUBLIC_URL (localhost while testing).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
