{
  "appId": "com.motio.app",
  "appName": "Motio",
  "webDir": "www",
  "backgroundColor": "#4B3FD8",
  "android": {
    "allowMixedContent": false,
    "useLegacyBridge": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_launcher_monochrome",
      "iconColor": "#5B4FE0"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#4B3FD8",
      "launchFadeOutDuration": 220,
      "showSpinner": false
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}