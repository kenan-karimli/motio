{
	"appId": "com.motio.app",
	"appName": "Motio",
	"webDir": "www",
	"backgroundColor": "#ECECEA",
	"android": {
		"allowMixedContent": false,
		"useLegacyBridge": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"LocalNotifications": {
			"smallIcon": "ic_launcher_monochrome",
			"iconColor": "#141414"
		},
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#ECECEA",
			"launchFadeOutDuration": 220,
			"showSpinner": false
		},
		"CapacitorHttp": {
			"enabled": true
		}
	}
}
